{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.phillipclapham/anneal-memory",
  "description": "A rolling memory file for AI agents: capture episodes, recall them, and wrap each day into the file. MCP, CLI and library. Zero dependencies.",
  "repository": {
    "url": "https://github.com/phillipclapham/anneal-memory",
    "source": "github"
  },
  "version": "4.0.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "anneal-memory",
      "version": "4.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [],
      "arguments": [
        "--db",
        "./memory.db",
        "--project-name",
        "MyProject",
        "serve"
      ]
    }
  ]
}
